# Shark Tank AI — example environment variables
# Copy this file to .env and fill in real values as needed.
# The application starts successfully even with none of these set —
# without ANTHROPIC_API_KEY, every stage falls back to a deterministic
# placeholder instead of real AI reasoning (see README).

# --- The only setting most users need ---
# Get a key at https://console.anthropic.com/ — required for real,
# AI-driven simulations. Usage is billed by Anthropic per their pricing.
ANTHROPIC_API_KEY=

# --- General application settings ---
APP_NAME=Shark Tank AI
APP_ENV=development
DEBUG=true

# --- Streamlit / server settings ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8501

# --- Logging ---
LOG_LEVEL=INFO
LOG_TO_FILE=false
LOG_FILE_PATH=logs/app.log

# --- LLM provider ---
# Anthropic is the only implemented provider as of 1.0. LLM_PROVIDER
# is reserved for future use and has no effect yet; LLM_MODEL is real
# and selects the Anthropic model used for every AI call.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6

# --- Reserved for future releases (not yet implemented; safe to leave unset) ---
# OPENAI_API_KEY=
# MEMORY_BACKEND=in-memory
# DATABASE_URL=sqlite:///./data/app.db
# ENABLE_MULTI_AGENT_DEBATE=false
