# Shark Tank AI — example environment variables
# Copy this file to .env and fill in real values as needed.
# The application starts successfully even with none of these set.

# --- General application settings ---
APP_NAME=Shark Tank AI
APP_ENV=development
DEBUG=true

# --- Streamlit / server settings ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8501

# --- Logging ---
LOG_LEVEL=INFO
LOG_TO_FILE=false
LOG_FILE_PATH=logs/app.log

# --- LLM provider ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Memory / persistence ---
MEMORY_BACKEND=in-memory
DATABASE_URL=sqlite:///./data/app.db

# --- Feature flags ---
ENABLE_MULTI_AGENT_DEBATE=false
